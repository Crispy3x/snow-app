# Copy to .env.local for local dev. In Vercel, set these in Project Settings > Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only: webhooks, jobs, admin actions

# --- Encryption for eBay OAuth tokens and buyer ship-to data (AES-256-GCM) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# Regular monthly prices: Starter $94, Professional $494, Mentorship $994
STRIPE_PRICE_STARTER_MONTHLY=price_
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_
STRIPE_PRICE_MENTORSHIP_MONTHLY=price_
STRIPE_PRICE_COURSE_ONE_TIME=price_     # optional: course sold on its own
# 50%-off coupon for the Black Friday sale (see src/config/plans.ts)
STRIPE_COUPON_SALE=
STRIPE_TRIAL_DAYS=7

# --- eBay Developer Program (developer.ebay.com > Application Keys) ---
EBAY_ENV=sandbox                      # sandbox | production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=                         # the "RuName" (redirect URL name) for the consent flow
EBAY_DEV_ID=
# Marketplace account deletion endpoint (mandatory before production calls)
EBAY_DELETION_VERIFICATION_TOKEN=     # 32-80 chars, letters/digits/_/-
EBAY_DELETION_ENDPOINT_URL=https://YOUR-DOMAIN/api/ebay/notifications/account-deletion

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model routing (see src/config/ai.ts); override only if needed
AI_MODEL_BULK=claude-haiku-5-5
AI_MODEL_STANDARD=claude-sonnet-5-5
AI_MODEL_DEEP=claude-opus-5-5

# --- Inngest (background jobs) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Email (auth emails go through Supabase SMTP; transactional mail through this) ---
RESEND_API_KEY=
EMAIL_FROM="MarginPilot <support@marginpilot.com>"

# --- Course video (Mux recommended for signed playback) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
